# Server ONLY. NEVER put the DB URL in the iOS app or public GitHub secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/kova?sslmode=require
# Public base URL of your video delivery CDN (HTTPS, no trailing slash)
MEDIA_PUBLIC_URL=https://media.example.com
# Optional: S3-compatible private ingest bucket, configured with size limits/lifecycle policies
S3_ENDPOINT=https://your-s3-compatible-endpoint
S3_REGION=auto
S3_BUCKET=kova-videos
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me
