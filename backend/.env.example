# Server-only values. Do NOT commit real credentials or embed them in the iPhone IPA.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/kova?sslmode=require
# Private Neon Object Storage
S3_ENDPOINT=https://YOUR_BRANCH.storage.c-16.us-east-1.aws.neon.tech
S3_REGION=us-east-1
S3_BUCKET=kova-videos
S3_ACCESS_KEY_ID=YOUR_SCOPED_STORAGE_KEY
S3_SECRET_ACCESS_KEY=YOUR_SCOPED_STORAGE_SECRET
